generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Signature {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  city      String
  uf        String   @default("SP")
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
}
